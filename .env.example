# Copiá este archivo como .env.local para probar el tablero en tu computadora.
# En Vercel, estas variables se cargan en Settings > Environment Variables.

# Obligatoria para poder editar desde la página publicada.
ADMIN_PASSWORD=elegí-una-contraseña-larga

# Opcional: si la definís, toda la página queda privada y esta contraseña permite solo leer
# (útil para compartir el tablero con tu director/a).
# VIEWER_PASSWORD=

# Opcional: activa el botón "Detectar actores con IA" (clave de https://platform.claude.com).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
