# Copiá este archivo como .env.local para probar el tablero en tu computadora.
# En Vercel, estas variables se cargan en Settings > Environment Variables.

# Opcional. Si no la definís, cualquiera que abra la página puede editar.
# Si la definís, hace falta esta contraseña para editar.
# ADMIN_PASSWORD=

# Opcional: si la definís, toda la página queda privada y hace falta esta contraseña para verla.
# VIEWER_PASSWORD=

# Opcional: activa el botón "Detectar actores con IA" (clave de https://platform.claude.com).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
